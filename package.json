{
  "name": "trilha-do-teclado",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"env PORT=3001 tsx watch server/main.ts\" \"vite --host 0.0.0.0 --port 3000 --strictPort\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server-build.json",
    "check": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "content:import": "tsx scripts/import-legacy.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "start": "node server-dist/server/main.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "vite": "^6.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.8",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
